# ---------------------------------------------------------------------------
# Hevy Clone — environment variables
#
# Copy this file to `.env.local` for local development:
#     cp .env.example .env.local
#
# Create React App only exposes variables that start with REACT_APP_.
# All of them are OPTIONAL: the app runs fully offline against localStorage
# with the defaults below. Nothing here is a secret — never put private keys
# in a REACT_APP_* variable, because they are bundled into the client.
# ---------------------------------------------------------------------------

# Name shown in the navigation bar / browser tab.
REACT_APP_APP_NAME=Hevy Clone

# Optional REST backend, e.g. https://api.example.com
# Leave empty to use the built-in localStorage data layer.
REACT_APP_API_BASE_URL=

# Namespace used for localStorage keys. Change it to keep separate datasets
# (e.g. staging vs production) in the same browser.
REACT_APP_STORAGE_KEY=hevy-clone

# Seed the app with demo workouts/routines on first load.
# Set to "false" for a completely empty account.
REACT_APP_SEED_DEMO_DATA=true

# Optional public origin used when copying share links.
# Defaults to window.location.origin when empty.
REACT_APP_PUBLIC_BASE_URL=
